if (!require("BiocManager", quietly = TRUE))
install.packages("BiocManager")
BiocManager::install("edgeR")
library(edgeR)
# Load the data
filtered_genes <- read.csv('Signature-pairs/taxon-gene-pivot.csv',  header = TRUE, row.names = 1)
# Create the DGEList Object
groups <- gsub("_.*", "", colnames(filtered_genes))
q <- DGEList(counts=filtered_genes, group=factor(groups))
# Calculate logCPM before normalization
logCPM_before <- cpm(q, log=TRUE, prior.count = 1)
# Perform TMM normalization
q <- calcNormFactors(q)
# Calculate logCPM after normalization
logCPM_after <- cpm(q, log=TRUE, prior.count = 1)
# --- Improved Boxplot Visualization ---
# 1. Reshape the data for boxplotting using melt or pivot_longer
library(reshape2)  # or use tidyr package for pivot_longer
# Before normalization
logCPM_before_melted <- melt(logCPM_before)  # Converts to long format
colnames(logCPM_before_melted) <- c("Gene", "Sample", "LogCPM")  # Rename columns
# After normalization
logCPM_after_melted <- melt(logCPM_after)
colnames(logCPM_after_melted) <- c("Gene", "Sample", "LogCPM")
# 2. Create boxplots using ggplot2 for better aesthetics and control
library(ggplot2)
# Before Normalization Boxplot
ggplot(logCPM_before_melted, aes(x = Sample, y = LogCPM)) +
geom_boxplot(fill = "skyblue", color = "black") +  # Boxplot aesthetics
ggtitle("Log-CPM Before Normalization") +
ylab("Log-CPM") +
xlab("Samples") +
theme_bw() +  # Clean theme
theme(axis.text.x = element_text(angle = 45, hjust = 1, size = 8))  # Rotate x-axis labels
# After Normalization Boxplot
ggplot(logCPM_after_melted, aes(x = Sample, y = LogCPM)) +
geom_boxplot(fill = "lightgreen", color = "black") +  # Boxplot aesthetics
ggtitle("Log-CPM After Normalization") +
ylab("Log-CPM") +
xlab("Samples") +
theme_bw() +  # Clean theme
theme(axis.text.x = element_text(angle = 45, hjust = 1, size = 8))  # Rotate x-axis labels
# --- Alternative: Density Plot Visualization (Good for large sample sizes) ---
# Before Normalization Density Plot
ggplot(logCPM_before_melted, aes(x = LogCPM, fill = Sample)) +
geom_density(alpha = 0.5) +  # Density plot with transparency
ggtitle("Log-CPM Density Before Normalization") +
xlab("Log-CPM") +
ylab("Density") +
theme_bw() +
theme(legend.position = "right") # Move legend for better readability
# After Normalization Density Plot
ggplot(logCPM_after_melted, aes(x = LogCPM, fill = Sample)) +
geom_density(alpha = 0.5) +  # Density plot with transparency
ggtitle("Log-CPM Density After Normalization") +
xlab("Log-CPM") +
ylab("Density") +
theme_bw() +
theme(legend.position = "right")
# Save normalized counts
normalized_counts <- cpm(q)
write.csv(normalized_counts, file = 'Signature-pairs/norm_taxon-gene-pivot.csv')
